{
    "production": {
        "django_settings": "core.settings",
        "profile_name": "default",
        "aws_region": "us-east-1",
        "project_name": "neoevents",
        "runtime": "python3.10",
        "s3_bucket": "neoevents-zappa-deployments-prod",
        "app_function": "core.wsgi.application",
        "keep_warm": true,
        "memory_size": 1024,
        "timeout_seconds": 30,
        "environment_variables": {
            "USE_S3": "True",
            "USE_SQS": "True"
        },
        "exclude": [
            "*.gz",
            "*.rar",
            "docker-compose.*",
            "Dockerfile*",
            "terraform/*"
        ],
        "events": [
            {
                "function": "sqs_worker.lambda_handler",
                "event_source": {
                    "arn": "arn:aws:sqs:us-east-1:123456789012:neoevents-email-queue-production",
                    "batch_size": 10
                }
            }
        ]
    }
}
