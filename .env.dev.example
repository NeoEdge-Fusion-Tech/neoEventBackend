# ==========================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env.dev and fill in values if needed
# The defaults here are designed to work perfectly with docker-compose.dev.yml

# Django Security
DEBUG=True
SECRET_KEY=local_dev_insecure_key_12345

# Database (PostgreSQL via Docker)
DB_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@db:5432/neoevents_db

# Redis (via Docker)
REDIS_URL=redis://redis:6379/0

# Media Uploads
# Set to False to bypass Amazon S3 and save images locally to /media/
USE_S3=False

# Microservice URLs (Internal Docker Networking)
FASTAPI_PROCESS_BATCH_URL=http://fastapi:8002/process-batch
FASTAPI_PROCESS_REFERENCE_URL=http://fastapi:8002/process-reference

# Email Service
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=dev@neoevents.local
