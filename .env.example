# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in values for Production

# Django Security
DEBUG=False
SECRET_KEY=your_super_secret_production_key_here
ALLOWED_HOSTS=api.neoevents.com,localhost

# Database (PostgreSQL)
# e.g. postgres://username:password@rds.amazon.com:5432/neoevents_db
DATABASE_URL=postgres://postgres:secure_password@db_host:5432/neoevents_prod

# Redis (For Celery Task Queue)
# e.g. redis://elasticache.amazon.com:6379/0
REDIS_URL=redis://redis_host:6379/0

# Amazon S3 — Production media storage (used automatically when DEBUG=False)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION_NAME=us-east-1

# Note: Cloudinary is only used in development/staging (DEBUG=True). No keys needed here.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Amazon SQS (For Serverless Background Tasks)
USE_SQS=True
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/neoevents-email-queue

# Microservice URLs
FASTAPI_PROCESS_BATCH_URL=http://fastapi_prod_host:8002/process-batch
FASTAPI_PROCESS_REFERENCE_URL=http://fastapi_prod_host:8002/process-reference

# Email Service (e.g. Amazon SES, Resend, Sendgrid)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_api_key
# DEFAULT_FROM_EMAIL=no-reply@neoevents.com


# ── Resend Configuration ──────────────────────────────────────────────────────
# Your Resend API Key (starts with re_...)
RESEND_API_KEY=re_xxxx

# Default From Email (e.g. "NeoEvent <onboarding@resend.dev>" or your custom verified domain email)
DEFAULT_FROM_EMAIL=NeoEvent <no-reply@suavesystems.com>

# Support Email address
SUPPORT_EMAIL=support@neoevents.com
PAYSTACK_SECRET_KEY=sk_ccccc
