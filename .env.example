# ── Resend Configuration ──────────────────────────────────────────────────────
# Your Resend API Key (starts with re_...)
RESEND_API_KEY=re_your_api_key_here

# Default From Email (e.g. "NeoEvent <onboarding@resend.dev>" or your custom verified domain email)
DEFAULT_FROM_EMAIL=NeoEvent <onboarding@resend.dev>

# Support Email address
SUPPORT_EMAIL=support@neoevents.com
